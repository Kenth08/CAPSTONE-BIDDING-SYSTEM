# Copy this file to ".env" and fill in your Supabase credentials.
# Find these in Supabase: Project Settings -> Database -> Connection info
# (use the "Session pooler" / port 5432 values, or the direct connection).

DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_HOST=aws-0-xxxx.pooler.supabase.com
DB_PORT=5432

# Optional: SMTP creds so password-reset emails actually get delivered.
# Leave unset and emails are just printed to the server console (fine for dev).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=no-reply@eprocurement.local

# ── Blockchain anchoring (Sepolia testnet) ──────────────────────────────────
# All optional. With none of these set, the backend still hashes every status
# transition and stores the hash locally; records simply read "not yet anchored"
# until a browser (MetaMask) writes them on-chain.

# Address of the deployed ProcurementLedger contract — see contracts/README.md.
# Used for the public verification page and the optional server-signing path.
LEDGER_CONTRACT_ADDRESS=

# Read-only Sepolia RPC endpoint. Defaults to a public node when unset.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Set to False to skip anchoring entirely (e.g. in CI). Default: True.
BLOCKCHAIN_ANCHORING_ENABLED=True

# ── Optional: server-side signing instead of MetaMask ───────────────────────
# Off by default; MetaMask is the demo path. Turn this on to have the backend
# submit anchor transactions itself with web3.py (needs `pip install web3`),
# which is how you would run this in production with no wallet in the loop.
# BLOCKCHAIN_PRIVATE_KEY belongs to a throwaway TEST wallet holding only Sepolia
# test ETH — never a wallet with real funds, and never committed to git.
BLOCKCHAIN_SERVER_SIGNING=False
BLOCKCHAIN_PRIVATE_KEY=
