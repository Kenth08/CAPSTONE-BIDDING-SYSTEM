# Copy this file to ".env" (in this frontend/ folder) and fill in the values.
# Vite only reads env vars at STARTUP — restart `npm run dev` after editing.
# Only variables prefixed VITE_ are exposed to the browser.

# Backend API base URL. Leave unset for local development (defaults to
# http://127.0.0.1:8000/api).
# VITE_API_URL=https://your-api.onrender.com/api

# ── Blockchain (Sepolia testnet) ────────────────────────────────────────────
# Address of your deployed ProcurementLedger contract. Get this by deploying
# contracts/ProcurementLedger.sol in Remix — see contracts/README.md.
# Without it, the app still works normally; records just show "not anchored".
VITE_LEDGER_ADDRESS=

# Read-only Sepolia RPC endpoint, used by the public verification page (no
# wallet, no gas). Optional — falls back to a public endpoint. Set your own
# (Alchemy / Infura / QuickNode) if the public one gets rate-limited.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
